#!/bin/sh
yad --title="مرحبًا بك في الرازي" --window-icon=/usr/share/pixmaps/razi.png --image=/usr/share/razi/logo-96.png \
 --width=560 --height=470 --fixed --center --button="ابدأ الاستخدام:0" --text="<span size='x-large'><b>أهلًا بك في الرازي على هاتفك</b></span>

يعمل الرازي الآن داخل هاتفك جنبًا إلى جنب مع أندرويد، دون مسح أي شيء.

<b>نصائح للهاتف</b>
•  أدِر الهاتف أفقيًا للحصول على أوسع سطح مكتب.
•  اللمس = نقرة، والضغط المطوّل = النقر الأيمن، وإصبعان للتمرير.
•  لوحة المفاتيح: من الزر الجانبي في يسار الشاشة.
•  ملفات هاتفك تجدها في مجلد «ذاكرة الهاتف».
•  للإيقاف: اكتب ‏razi stop‏ في Termux.

<b>اختصارات مع لوحة مفاتيح خارجية</b>
•  قائمة ابدأ: زر ‏Windows‏ أو شعار الرازي يمين الشريط
•  تبديل لغة الكتابة: ‏Alt + Shift‏ ، والتنقل بين النوافذ: ‏Alt + Tab"
