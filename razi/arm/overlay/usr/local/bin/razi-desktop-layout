#!/bin/sh
# ترتيب أيقونات سطح المكتب من أعلى اليمين كما في ويندوز العربي (مرة واحدة لكل مستخدم)
CONF="$HOME/.config/pcmanfm/razi/desktop-items-0.conf"
FLAG="$HOME/.config/pcmanfm/razi/.arranged"
[ -f "$FLAG" ] && exit 0
mkdir -p "$(dirname "$CONF")"
[ -f "$CONF" ] || cp /etc/xdg/pcmanfm/razi/desktop-items-0.conf "$CONF"
W=$(xrandr --current 2>/dev/null | sed -n 's/.*current \([0-9]*\) x \([0-9]*\).*/\1/p'); H=$(xrandr --current 2>/dev/null | sed -n 's/.*current \([0-9]*\) x \([0-9]*\).*/\2/p')
[ -n "$W" ] || { W=1024; H=768; }
DESK=$(xdg-user-dir DESKTOP)
X=$((W - 104)); Y=12
for f in "$DESK"/*.desktop; do
  [ -f "$f" ] || continue
  printf '\n[%s]\nx=%d\ny=%d\n' "$(basename "$f")" "$X" "$Y" >> "$CONF"
  Y=$((Y + 96)); if [ $((Y + 150)) -gt "$H" ]; then Y=12; X=$((X - 100)); fi
done
touch "$FLAG"
