#!/bin/sh
INSTALL_HINT=""
[ -x /usr/local/bin/razi-install ] && INSTALL_HINT="

<b>للتثبيت الدائم:</b> اختر «تثبيت الرازي على هذا الجهاز» من القائمة."
yad --title="مرحبًا بك في الرازي" --window-icon=/usr/share/pixmaps/razi.png --image=/usr/share/razi/logo-96.png \
 --width=520 --height=480 --fixed --center --button="ابدأ الاستخدام:0" --text="<span size='x-large'><b>أهلًا بك في نظام الرازي</b></span>

نظام تشغيل عربي خفيف ومفتوح المصدر، صُمِّم ليُعيد الحياة إلى الأجهزة القديمة ويعمل بسلاسة على الحديثة.

<b>اختصارات مفيدة</b>
•  قائمة ابدأ: زر ‏Windows‏ أو شعار الرازي يمين الشريط
•  مستكشف الملفات: ‏Windows + E‏، وسطح المكتب: ‏Windows + D
•  تثبيت أي برنامج: انقر مرتين على الملف الذي نزّلته
•  تبديل لغة الكتابة: ‏Alt + Shift
•  فتح الطرفية: ‏Ctrl + Alt + T
•  التنقل بين النوافذ: ‏Alt + Tab

اسم المستخدم في الوضع الحي: ‏razi‏ (دون كلمة مرور)$INSTALL_HINT"
